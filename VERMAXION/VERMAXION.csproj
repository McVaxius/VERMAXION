<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.0.0.6</Version>
    <FileVersion>2.0.0.6</FileVersion>
    <AssemblyVersion>2.0.0.6</AssemblyVersion>
    <PackageProjectUrl>https://github.com/McVaxius/VERMAXION</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath Condition="$(DALAMUD_HOME) != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI\AethertekUI.csproj" />
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI.Dalamud\AethertekUI.Dalamud.csproj" />
    <EmbeddedResource Update="Localization\Strings_*.resx" WithCulture="false" />
    <PackageReference Include="ECommons" Version="3.2.0.17" />
    <PackageReference Include="PInvoke.User32" Version="0.7.0" />
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\fish-collection.json" />
    <EmbeddedResource Include="Resources\ocean-collection-presets.json" />
  </ItemGroup>

  <Target Name="CopyPluginArtifacts" AfterTargets="Build">

    <PropertyGroup>

      <PluginOutput>$(TargetDir)$(AssemblyName)</PluginOutput>

    </PropertyGroup>

    <MakeDir Directories="$(PluginOutput)" />

    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
      <PluginFiles Include="$(TargetDir)AethertekUI.dll" />
      <PluginFiles Include="$(TargetDir)AethertekUI.Dalamud.dll" />
      <PluginFiles Include="$(ProjectDir)$(AssemblyName).json" />
      <PluginFiles Include="images\icon.png" />
      <PluginFiles Include="images\carrying chest of gold.png" />
      <PluginFiles Include="images\carrying chest of gold cleaned.png" />
      <PluginFiles Include="images\source image ai generated.png" />
      <PluginFiles Include="images\kofi-logo.png" />
    </ItemGroup>

    
    <Copy SourceFiles="@(PluginFiles)"

          DestinationFolder="$(PluginOutput)" />
    <Copy SourceFiles="$(ProjectDir)images\icon.png" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />

  </Target>

</Project>
